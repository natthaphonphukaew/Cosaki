# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/cosaki_dev

# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Facebook OAuth ───────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ── Object storage (Cloudflare R2 / S3-compatible) ─
# R2: set S3_ENDPOINT to https://<account_id>.r2.cloudflarestorage.com,
#     S3_PUBLIC_URL to the bucket's public r2.dev URL (Bucket → Settings → Public Development URL).
# Leave blank in dev to run without storage (uploads fall back to inline data URLs).
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
AWS_REGION=auto
AWS_S3_BUCKET=cosaki-media

# Keep KYC auto-approving (demo) even after storage is configured, until an
# admin review flow exists. Set to "false" only when real review is ready.
KYC_AUTO_APPROVE=true

# ── Payment (Omise) ──────────────────────────────
OMISE_PUBLIC_KEY=pkey_test_xxx
OMISE_SECRET_KEY=skey_test_xxx
OMISE_WEBHOOK_SECRET=whsec_xxx

# ── SMS / OTP ────────────────────────────────────
SMS_PROVIDER_API_KEY=your_sms_api_key
SMS_SENDER_ID=Cosaki
