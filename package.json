{
  "name": "cosaki",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["server", "client"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:server":  "npm run dev --workspace=server",
    "dev:client":  "npm run dev --workspace=client",
    "migrate":     "npm run migrate --workspace=server",
    "seed":        "npm run seed --workspace=server",
    "install:all": "npm install --workspaces",
    "build":       "npm install --workspaces --include=dev && npm run build --workspace=client",
    "start":       "node server/db/migrate.js && node server/src/app.js",
    "format":      "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check":"prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "lint":        "npm run lint --workspace=client"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
